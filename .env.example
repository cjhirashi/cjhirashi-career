# ============================================================================
# cjhirashi-career Environment Variables
# ============================================================================
# Regenerated from config.py — this is the source of truth for all settings
# IMPORTANT: Copy this file to .env and fill in with real values
# NEVER commit .env to the repository
# ============================================================================

# ============================================================================
# PostgreSQL Database (REQUIRED)
# ============================================================================
POSTGRES_USER=career_admin
POSTGRES_PASSWORD=your-secure-password-here-min-20-chars
POSTGRES_DB=career_db
DATABASE_URL=postgresql+asyncpg://career_admin:your-secure-password-here-min-20-chars@postgres:5432/career_db

# ============================================================================
# JWT and Security (REQUIRED)
# ============================================================================
# SECRET_KEY must be at least 32 characters
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================================
# CORS and Application Metadata
# ============================================================================
# CORS_ORIGINS_STR: comma-separated list of allowed origins (no spaces)
CORS_ORIGINS_STR=http://localhost:8002,http://localhost:8003,http://localhost:8004
APP_NAME=cjhirashi-career API
APP_VERSION=1.0.0
DEBUG=false
UPLOADS_DIR=/app/uploads

# ============================================================================
# File Upload Configuration
# ============================================================================
MAX_UPLOAD_SIZE_MB=50
# Allowed extensions: pdf, doc, docx, jpg, jpeg, png, gif
# Note: This list is enforced in config.py as ALLOWED_EXTENSIONS

# ============================================================================
# Rate Limiting (local, in-process)
# ============================================================================
# Note: Fase 5 will move this to centralized Gateway + Redis
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# Pagination Defaults for CRUD List Endpoints
# ============================================================================
DEFAULT_SKIP=0
DEFAULT_LIMIT=20
MAX_LIMIT=100

# ============================================================================
# AWS Bedrock — Converse API, Embeddings, Image Generation
# See docs/BEDROCK-SYSTEM.md for agent architecture details
# ============================================================================
BEDROCK_REGION=us-east-1
BEDROCK_USE_CONVERSE_STREAM=false
# Model IDs (defaults can be overridden in docker-compose.yml environment section)
BEDROCK_DEFAULT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_ORCHESTRATOR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_IMAGE_MODEL_ID=amazon.titan-image-generator-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Limits
BEDROCK_MAX_IMAGES_PER_DAY=20
BEDROCK_MAX_TOOL_RESULT_CHARS=8000
BEDROCK_MAX_DELEGATIONS_PER_TURN=3
BEDROCK_HISTORY_WINDOW=20
BEDROCK_MAX_ROUND_TRIPS=6
# Prompt Caching (ADR-019, only applies to Claude models with supports_prompt_cache=true)
BEDROCK_PROMPT_CACHE_ENABLED=true
# Budget control (USD, checked daily)
BEDROCK_DAILY_BUDGET_USD=5.0
# AWS credentials (REQUIRED to call Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# Qdrant — Vector Knowledge Base for Agent Bedrock
# ============================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=career_knowledge

# ============================================================================
# MinIO — S3-compatible Object Storage (REQUIRED)
# ============================================================================
# MINIO_ENDPOINT: internal Docker network (service name + port)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=portafolio-minio-admin
MINIO_ROOT_PASSWORD=your-secure-password-here-min-20-chars
MINIO_BUCKET=cjhirashi-career
# MINIO_PUBLIC_URL: public base URL where the bucket is exposed (via Caddy)
MINIO_PUBLIC_URL=https://files.cjhirashi.com

# ============================================================================
# LinkedIn OAuth (Sign In + Publish)
# ============================================================================
# Obtain credentials from https://www.linkedin.com/developers/apps (no app review needed)
# Redirect URI must be added to the app's "Authorized redirect URLs" exactly as specified
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://admin.cjhirashi.com/api/linkedin/callback
LINKEDIN_FRONTEND_URL=https://admin.cjhirashi.com/linkedin

# ============================================================================
# Job Discovery — Adzuna API
# ============================================================================
# Free developer keys available at https://www.adzuna.com/api/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=mx
JOB_DISCOVERY_TIMEOUT_SECONDS=8.0
JOB_DISCOVERY_MAX_RESULTS=50
JOB_DISCOVERY_USER_AGENT=cjhirashi-career/1.0 (job-discovery; +https://cjhirashi.com)

# ============================================================================
# GitHub — Read-only PAT for L3 agent_github
# ============================================================================
# Fine-grained PAT: Contents Read + Metadata. For private repos, also request
# Repository access. Without a token, only public repos of the stored username.
GITHUB_TOKEN=

# ============================================================================
# Web Search — Brave Search (optional, defaults to DuckDuckGo if empty)
# ============================================================================
BRAVE_SEARCH_API_KEY=

# ============================================================================
# Public Portal — User ID for /public/* unauthenticated routes
# ============================================================================
# Prefixed user ID (e.g., usr-2), not a raw integer. Numeric values are auto-coerced.
PUBLIC_PORTAL_USER_ID=usr-2

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Grafana (new in FASE 0 — observability stack)
# ============================================================================
# Default admin password (MUST change in production)
GRAFANA_ADMIN_PASSWORD=admin
