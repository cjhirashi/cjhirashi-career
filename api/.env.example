# Portafolio-cjhirashi API Environment Variables

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================
# PostgreSQL async connection string - REQUIRED for production
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://mcpuser:mcppass123@postgres:5432/portafolio_db

# ============================================================================
# SECURITY CONFIGURATION (REQUIRED)
# ============================================================================
# JWT Secret Key (MUST be at least 32 characters - REQUIRED for production)
# Generate unique key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=portafolio-dev-secret-key-change-this-in-production-at-least-32-chars

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS_STR=http://localhost:8002,http://localhost:8003,http://localhost:8004

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=Portafolio-cjhirashi API
APP_VERSION=1.0.0
DEBUG=False

# ============================================================================
# FILE UPLOADS
# ============================================================================
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png,gif

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# PAGINATION
# ============================================================================
DEFAULT_SKIP=0
DEFAULT_LIMIT=20
MAX_LIMIT=100

# ============================================================================
# AWS BEDROCK (Optional) - Agent Bedrock, chat via AgentCore Harness +
# Titan Embeddings. BEDROCK_HARNESS_ARN is created once via the AWS CLI
# (see docs/09-DECISIONS), not something you type up-front.
# ============================================================================
BEDROCK_REGION=us-east-1
BEDROCK_HARNESS_ARN=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# QDRANT (Agent Bedrock's local knowledge base)
# ============================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=career_knowledge
