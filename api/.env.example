# Configuración de Base de Datos
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/mcp_db

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production-min-32-chars-recommended
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# CORS Origins (separados por comas)
CORS_ORIGINS=http://localhost:8003,http://mcp_frontend:8000,http://localhost:3000

# App Configuration
APP_NAME=MCP Tools API
APP_VERSION=1.0.0
DEBUG=false
