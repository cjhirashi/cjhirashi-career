# ============================================================================
# cjhirashi-career-ai Environment Variables (FASE 3)
# ============================================================================
# Microservicio de IA extraído del monolito
# Copy to .env and fill with real values

# ============================================================================
# Service Configuration
# ============================================================================
APP_NAME=cjhirashi-career IA
APP_VERSION=1.0.0
DEBUG=false

# ============================================================================
# Database (for usage logs and conversation history)
# ============================================================================
DATABASE_URL=postgresql+asyncpg://career_admin:your-secure-password@postgres:5432/career_db

# ============================================================================
# JWT & Security
# ============================================================================
# Must match Orchestrator API SECRET_KEY for token verification
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256

# ============================================================================
# AWS Bedrock — Converse API, Embeddings, Image Generation
# ============================================================================
BEDROCK_REGION=us-east-1
BEDROCK_DEFAULT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_ORCHESTRATOR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_IMAGE_MODEL_ID=amazon.titan-image-generator-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_MAX_IMAGES_PER_DAY=20
BEDROCK_DAILY_BUDGET_USD=5.0
BEDROCK_MAX_ROUND_TRIPS=6
BEDROCK_HISTORY_WINDOW=20
BEDROCK_PROMPT_CACHE_ENABLED=true

# AWS Credentials (REQUIRED to call Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# Qdrant — Vector Knowledge Base for Agent
# ============================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=career_knowledge

# ============================================================================
# Orchestrator API — for Career CRUD operations
# Internal HTTP calls (from IA service → Orchestrator)
# ============================================================================
ORCHESTRATOR_API_BASE_URL=http://api:8001
ORCHESTRATOR_API_TIMEOUT_SECONDS=30

# ============================================================================
# MinIO — for file uploads referenced in agent tools
# ============================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=portafolio-minio-admin
MINIO_ROOT_PASSWORD=your-secure-password-here-min-20-chars
MINIO_BUCKET=cjhirashi-career
MINIO_PUBLIC_URL=https://files.cjhirashi.com

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
