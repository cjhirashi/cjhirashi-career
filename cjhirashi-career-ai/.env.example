# cjhirashi-career-ai - variables del harness (spec 009). Copiar a .env (no se versiona).

# BD propia (usuario sin permisos sobre career_db)
AI_DATABASE_URL=postgresql+asyncpg://career_ai:CAMBIAR@postgres_db:5432/career_ai_db

# JWT: MISMO SECRET_KEY y ALGORITHM que cjhirashi-career-api (un único .env)
SECRET_KEY=cambiar-por-un-secreto-de-al-menos-32-caracteres
ALGORITHM=HS256

# Frontera de salida hacia la API de datos
API_BASE_URL=http://cjhirashi-career-api:8000
AI_SERVICE_TOKEN=cambiar-jwt-de-la-cuenta-de-servicio

# Memoria del agente (full-text de Postgres)
MEMORY_FTS_CONFIG=spanish
