# Test environment configuration for pytest
APP_NAME=cjhirashi-career-ai-test
APP_VERSION=1.0.0
DEBUG=true

# Database — can be test DB or in-memory
DATABASE_URL=postgresql+asyncpg://test_user:test_password@localhost:5432/test_db

# JWT & Security
SECRET_KEY=test-secret-key-min-32-characters-for-testing-only-1234567890
ALGORITHM=HS256

# AWS Bedrock (dummy values for testing)
BEDROCK_REGION=us-east-1
BEDROCK_DEFAULT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_ORCHESTRATOR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_IMAGE_MODEL_ID=amazon.titan-image-generator-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_MAX_IMAGES_PER_DAY=20
BEDROCK_DAILY_BUDGET_USD=5.0
BEDROCK_MAX_ROUND_TRIPS=6
BEDROCK_HISTORY_WINDOW=20
BEDROCK_PROMPT_CACHE_ENABLED=false

# AWS Credentials (dummy for testing)
AWS_ACCESS_KEY_ID=test-key-id
AWS_SECRET_ACCESS_KEY=test-secret-key

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=test_collection

# Orchestrator API
ORCHESTRATOR_API_BASE_URL=http://localhost:8001
ORCHESTRATOR_API_TIMEOUT_SECONDS=5

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=test-user
MINIO_ROOT_PASSWORD=test-password
MINIO_BUCKET=test-bucket
MINIO_PUBLIC_URL=http://localhost:9000

# Logging
LOG_LEVEL=DEBUG
