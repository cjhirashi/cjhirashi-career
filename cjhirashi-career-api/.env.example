# cjhirashi-career API Environment Variables

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================
# PostgreSQL async connection string - REQUIRED for production
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://mcpuser:mcppass123@postgres:5432/career_db

# ============================================================================
# SECURITY CONFIGURATION (REQUIRED)
# ============================================================================
# JWT Secret Key (MUST be at least 32 characters - REQUIRED for production)
# Generate unique key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=portafolio-dev-secret-key-change-this-in-production-at-least-32-chars

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS_STR=http://localhost:8002,http://localhost:8003,http://localhost:8004

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=cjhirashi-career API
APP_VERSION=1.0.0
DEBUG=False

# ============================================================================
# FILE UPLOADS
# ============================================================================
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png,gif

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# PAGINATION
# ============================================================================
DEFAULT_SKIP=0
DEFAULT_LIMIT=20
MAX_LIMIT=100

# ============================================================================
# AWS BEDROCK — Converse API. Ver docs/BEDROCK-SYSTEM.md
# ============================================================================
BEDROCK_REGION=us-east-1
BEDROCK_USE_CONVERSE_STREAM=false
BEDROCK_DEFAULT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_ORCHESTRATOR_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_IMAGE_MODEL_ID=amazon.titan-image-generator-v2:0
BEDROCK_MAX_IMAGES_PER_DAY=20
BEDROCK_DAILY_BUDGET_USD=5.0
BEDROCK_MAX_ROUND_TRIPS=6
BEDROCK_HISTORY_WINDOW=20
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# QDRANT (Agent Bedrock's local knowledge base)
# ============================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=career_knowledge

# ============================================================================
# JOB DISCOVERY (Indeed via Adzuna)
# ============================================================================
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=mx
JOB_DISCOVERY_TIMEOUT_SECONDS=8
JOB_DISCOVERY_MAX_RESULTS=50
