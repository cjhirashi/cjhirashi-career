# ---------------------------------------------------------------------------
# Variables de entorno - Frontend MCP Tools Server
# ---------------------------------------------------------------------------
# Copiar a .env.local para desarrollo local (`npm run dev`).
# En produccion (Docker) estas variables NO se usan en build time; en su lugar
# el contenedor lee las variables equivalentes en tiempo de ejecucion
# (ver Dockerfile / docker-entrypoint.sh / docker-compose.yml).
# ---------------------------------------------------------------------------

# Nombre de la aplicacion mostrado en la UI.
VITE_APP_NAME="MCP Tools Server"

# Host:puerto contra el que el proxy de desarrollo de Vite reenvia las rutas
# /sse, /messages y /files. Debe apuntar al puerto expuesto en el host por
# docker-compose.yml raiz para el servicio mcp-tools (por defecto 8002).
VITE_MCP_PROXY_TARGET="http://localhost:8002"
