# Configuracion de nginx para el frontend de MCP Tools Server.
#
# Este archivo es una PLANTILLA: la imagen oficial de nginx ejecuta
# `envsubst` automaticamente sobre los archivos en /etc/nginx/templates/*.template
# al arrancar el contenedor, generando /etc/nginx/conf.d/default.conf con las
# variables de entorno sustituidas (ver Dockerfile, seccion ENV).
#
# Responsabilidades de este servidor:
#   1. Servir el bundle estatico de React (SPA con fallback a index.html).
#   2. Actuar como reverse proxy MISMO-ORIGEN hacia el servidor MCP (contenedor
#      mcp_tools_server) para el handshake SSE y los mensajes JSON-RPC. Esto
#      evita CORS por completo y evita exponer nombres DNS internos de Docker
#      (no resolubles desde el navegador) directamente al cliente.
#   3. Servir de solo lectura, con listado JSON, los PDFs generados por el
#      servidor MCP (volumen compartido montado en modo lectura), permitiendo
#      descarga y vista previa sin necesidad de nuevos endpoints en server.py.

resolver 127.0.0.11 valid=10s;

server {
    listen 8000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Variable indirecta: fuerza a nginx a resolver el nombre DNS del
    # servidor MCP en tiempo de ejecucion (via `resolver` arriba) en cada
    # peticion, en lugar de una unica vez al cargar la configuracion. Esto
    # evita que nginx falle al iniciar si mcp_tools_server aun no esta listo,
    # y tolera reinicios/recreaciones del contenedor upstream.
    set $mcp_upstream "http://${MCP_UPSTREAM}";

    # --- Aplicacion React (SPA) ---
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /config.js {
        add_header Cache-Control "no-store";
    }

    # --- Handshake SSE del protocolo MCP ---
    location /sse {
        proxy_pass $mcp_upstream/sse;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 3600s;
    }

    # --- Mensajes JSON-RPC (endpoint de sesion generado dinamicamente) ---
    location /messages/ {
        proxy_pass $mcp_upstream/messages/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # --- Documentos generados (solo lectura, listado JSON) ---
    location /files/cvs/ {
        alias /mnt/disco2/cjhirashi-data/mcp-outputs/cvs/;
        autoindex on;
        autoindex_format json;
        add_header Cache-Control "no-store";
    }

    location /files/cover_letters/ {
        alias /mnt/disco2/cjhirashi-data/mcp-outputs/cover_letters/;
        autoindex on;
        autoindex_format json;
        add_header Cache-Control "no-store";
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location ~* \.(?:css|js|svg|woff2?)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
